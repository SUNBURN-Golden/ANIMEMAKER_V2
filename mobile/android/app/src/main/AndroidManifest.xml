<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 권한: 인터넷, 오래 걸리는 일(영상 만들기) 동안 알림줄 서비스, 알림 (안드로이드 13+ 는 사용자가 허락해야 보인다) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 작품은 앱 안 저장소에만 있어요. 자동 백업은 일부만 복원될 수 있어서 끈다 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 다른 앱(ChatGPT·Gemini·Grok·갤러리 등)에서 '공유 → AnimeMaker V2' 로 그림·노래·글·캐릭터 파일(.amchar)을 받는다.
                 영상(video/*)은 받지 않는다. .amchar 는 앱마다 application/json 이나 application/octet-stream 으로 오기 때문에 둘 다 받는다. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

        </activity>

        <!-- 오래 걸리는 일(영상 만들기 등) 동안 앱이 멈추지 않게 하는 서비스. 안드로이드 14 이상은 종류(dataSync)를 꼭 적어야 해요 -->
        <service
            android:name=".JobService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- 설치된 AI 앱을 찾아서 바로 보내기 위해 (안드로이드 11 이상).
         이 목록은 src/native.js 의 AI_APPS 표와 같아야 해요 (mobile/test/native.test.js 가 확인해요) -->
    <queries>
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="ai.x.grok" />
        <package android:name="com.anthropic.claude" />
    </queries>

</manifest>
